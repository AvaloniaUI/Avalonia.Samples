<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestApiSample.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:RestApiSample.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RestApiSample.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RestApiSample"
        Loaded="HandleWindowLoaded">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Margin="5"
                Padding="5"
                BorderBrush="LightGray"
                CornerRadius="5"
                BorderThickness=".75">
            <StackPanel Spacing="7"
                        HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal"
                            Spacing="5">
                    <TextBox PlaceholderText="Pokemon name"
                             Text="{Binding PokemonName}"
                             Width="125"/>

                    <ComboBox ItemsSource="{Binding AllPokemonTypes}"
                              SelectedItem="{Binding CurrentPokemonType}"
                              PlaceholderText="Select type">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:PokemonType">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding AllPokemonGenerations}"
                              SelectedItem="{Binding CurrentPokemonGeneration}"
                              PlaceholderText="Select generation">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:PokemonGeneration">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="5">
                    <ComboBox ItemsSource="{Binding SortFields}"
                              SelectedItem="{Binding CurrentSortField}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding SortDirections}"
                              SelectedItem="{Binding CurrentSortDirection}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="5">
                    <Button Content="Search"
                            Command="{Binding SearchCommand}" />
                    <Button Content="Clear"
                            Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top">
            <Label Content="Loading..."
                   IsVisible="{Binding IsLoading}"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Pokemons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="240"
                                   Margin="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="224"
                                Margin="4"
                                Padding="14"
                                Background="#FAFAFA"
                                BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">
                                    <Border Background="#E8F1FF"
                                            Padding="7,3"
                                            CornerRadius="10">
                                        <TextBlock Text="{Binding Id, StringFormat=\#{0:D4}}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Types}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,5,0"
                                                    Padding="8,2"
                                                    Background="#EDF7EE"
                                                    CornerRadius="10">
                                                <TextBlock Text="{Binding Type.Name}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="Height"
                                                   Foreground="DimGray" />
                                        <TextBlock Text="{Binding HeightMetres, StringFormat={}{0:0.0} m}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Weight"
                                                   Foreground="DimGray" />
                                        <TextBlock Text="{Binding WeightKilograms, StringFormat={}{0:0.0} kg}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="Base experience"
                                                   Foreground="DimGray" />
                                        <TextBlock Text="{Binding BaseExperience}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
