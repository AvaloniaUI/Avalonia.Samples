<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CalendarDatePickerEx.Controls"
             x:Class="CalendarDatePickerEx.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="Themes/CalendarDatePickerExTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        
        <Style Selector="CalendarDatePicker, controls|CalendarDatePickerEx">
            <Setter Property="MinWidth" Value="200"></Setter>
        </Style>
    </Application.Styles>
</Application>