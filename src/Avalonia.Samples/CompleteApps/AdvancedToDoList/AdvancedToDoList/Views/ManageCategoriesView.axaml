<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:AdvancedToDoList.ViewModels"
             xmlns:services="clr-namespace:SharedControls.Services;assembly=SharedControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             services:DialogManager.Register="{Binding}"
             x:Class="AdvancedToDoList.Views.ManageCategoriesView"
             x:DataType="viewModels:ManageCategoriesViewModel">
    <Design.DataContext>
        <viewModels:ManageCategoriesViewModel />
    </Design.DataContext>
    
    <DockPanel VerticalSpacing="5">
        <CommandBar x:Name="CategoriesCommandBar"
                    DockPanel.Dock="Top"
                    Margin="10,5"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    IsDynamicOverflowEnabled="True">
            <CommandBar.PrimaryCommands>
                <CommandBarButton Label="Refresh"
                                  ToolTip.Tip="Refresh the List"
                                  Command="{Binding RefreshCommand}">
                    <CommandBarButton.Icon>
                        <PathIcon Data="{DynamicResource PhosphorIcons.ArrowCounterClockwiseLight}" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
                <CommandBarSeparator />
                <CommandBarButton Label="Add"
                                  ToolTip.Tip="Add"
                                  Command="{Binding AddNewCategoryCommand}">
                    <CommandBarButton.Icon>
                        <PathIcon Data="{DynamicResource PhosphorIcons.PlusCircleLight}" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
                <CommandBarButton Label="Edit"
                                  ToolTip.Tip="Edit"
                                  Command="{Binding EditCategoryCommand}"
                                  CommandParameter="{Binding SelectedCategory}">
                    <CommandBarButton.Icon>
                        <PathIcon Data="{DynamicResource PhosphorIcons.NotePencilLight}" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
                <CommandBarButton Label="Delete"
                                  ToolTip.Tip="Delete"
                                  Command="{Binding DeleteCategoryCommand}"
                                  CommandParameter="{Binding SelectedCategory}">
                    <CommandBarButton.Icon>
                        <PathIcon Data="{DynamicResource PhosphorIcons.TrashLight}" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <!-- The Categories -->
        <ListBox x:Name="CategoriesListBox" 
                 ItemsSource="{Binding Categories}"
                 Grid.IsSharedSizeScope="True"
                 SelectedItem="{Binding SelectedCategory}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BadgeColumn" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding}" />
                        <TextBlock Grid.Column="1" Text="{Binding Description}" 
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>